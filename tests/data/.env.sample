# Copy to tests/data/.env and fill in — .env is gitignored.
# Used by XXXX_load_COOP_amalgamation-CPXXXXX.ipynb (loaded via python-dotenv
# BEFORE `import legal_api`, because legal-api config reads env at import time).

# --- LEAR database via Cloud SQL connector (IAM auth, no password) ---
# legal-api config only falls through to the Cloud SQL branch when
CLOUDSQL_INSTANCE_CONNECTION_NAME=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_IP_TYPE=public

# --- colin-api (snapshot + events) ---
COLIN_API=https://<colin-api-host>/api/v1/businesses

# --- service-account client (client-credentials token used for ALL API calls:
#     colin-api + auth service; the client must carry the `colin` role) ---
ACCOUNT_SVC_AUTH_URL=
ACCOUNT_SVC_CLIENT_ID=
ACCOUNT_SVC_CLIENT_SECRET=
ACCOUNT_SVC_ENTITY_URL=https://<auth-api-host>/api/v1/entities
ACCOUNT_SVC_AFFILIATE_URL=https://<auth-api-host>/api/v1/orgs/{account_id}/affiliations
