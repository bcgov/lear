# --- LEAR Database (read-only use: identify impacted businesses and verify) ---
DATABASE_LEAR_USERNAME=
DATABASE_LEAR_PASSWORD=
DATABASE_LEAR_HOST=
DATABASE_LEAR_PORT=
DATABASE_LEAR_NAME=

# --- legal-api ---
# e.g. https://legal-api-dev.apps.silver.devops.gov.bc.ca/api/v2  (or the API gateway base + LEGAL_API_KEY)
LEGAL_API_URL=
# Staff JWT: the user must be allowed to file corrections and use staff payment (waiveFees)
LEGAL_API_TOKEN=
# Optional gateway x-apikey (leave blank when calling legal-api directly)
LEGAL_API_KEY=
# Staff account id sent as Account-Id
ACCOUNT_ID=
# Name recorded in header.certifiedBy on each correction
CERTIFIED_BY=

# --- Run control ---
# true = report and print payloads only (default); false = file the corrections
DRY_RUN=true
# Optional comma-separated allowlist from the Ops list, e.g. BC1156638,BC1164820. Blank = every impacted business found in the DB.
IDENTIFIERS=
# Where the results CSV is written
OUTPUT_DIR=../generated
