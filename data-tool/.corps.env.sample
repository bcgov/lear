ACCOUNT_SVC_CLIENT_ID=
ACCOUNT_SVC_CLIENT_SECRET=
ACCOUNT_SVC_TIMEOUT=


# delete script
## Auth database
DATABASE_USERNAME_AUTH=
DATABASE_PASSWORD_AUTH=
DATABASE_NAME_AUTH=
DATABASE_HOST_AUTH=
