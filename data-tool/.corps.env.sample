DATABASE_PORT=

DATABASE_POOL_PRE_PING=True
DATABASE_POOL_SIZE=1000
DATABASE_MAX_OVERFLOW=15
DATABASE_POOL_RECYCLE=3600

# reservation (reserve_for_flow) query statement timeout (Postgres statement_timeout, in ms).
# When set, long-running reservation queries fail fast instead of tying up a worker indefinitely.
RESERVE_STATEMENT_TIMEOUT_MS = 20000

#corp name suffix to append for test purposes
CORP_NAME_SUFFIX=" - IMPORT_TEST"

#AUTH - NO Auth values as no auth creation should take place
UPDATE_ENTITY=False
